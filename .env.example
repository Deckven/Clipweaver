# Copy to .env and fill in. .env is gitignored; clipmaker/config.py reads it at
# import time. A variable already set in the environment wins over the file.

# Where your raw game captures live (one subfolder per game, as listed in
# GAMES — clipmaker/games_local.py, see GUIDE.md section 3). Default: footage/raw
# inside the repo.
# CLIPMAKER_RAW_FOOTAGE_DIR=D:/footage/raw

# Where your video editor's project folders live (some GAMES entries index
# reference footage stored there). Default: footage/edit inside the repo.
# CLIPMAKER_EDIT_PROJECTS_DIR=D:/footage/edit

# Footage that moved (an archive drive, a renamed folder): catalog and layout
# paths starting with OLD are also looked up under NEW; the catalog itself is
# not rewritten. Pairs "OLD => NEW" separated by ";", the longest OLD wins.
# CLIPMAKER_PATH_MAP=D:/footage/raw/Old Game => F:/archive/Old Game; D:/footage/raw => F:/archive

# Optional: move the VLM catalog or the per-video projects out of the repo.
# Try the bundled sample with CLIPMAKER_CATALOG_DIR=examples/sample/catalog
# CLIPMAKER_CATALOG_DIR=
# CLIPMAKER_PROJECTS_DIR=

# Optional: local Ollama endpoint for narration -> shot queries.
# CLIPMAKER_OLLAMA_URL=http://localhost:11434/api/chat

# Optional: stock footage providers for the production plan. Empty = skipped.
PEXELS_API_KEY=
PIXABAY_API_KEY=
